DEEPL_API_KEY=tu-api-key-aqui

# Solo necesarios si usas descargar.py / listar_canales.py (descarga desde tu
# propio canal de Telegram). Consigue API_ID/API_HASH en https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_CANAL_ID=

# Opcional: ruta a tu vault de Obsidian, si quieres que la app guarde ahí
# traducciones/notas/esquemas de partida. Si se deja vacío, esas funciones
# concretas quedan desactivadas (el resto de la app funciona igual).
OBSIDIAN_BIBLIOTECA=
OBSIDIAN_PARTIDAS=
